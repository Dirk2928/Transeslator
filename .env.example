# Route prompts from the AI chatbox through your own endpoint.
#
# Contract:
#   POST <AI_ENHANCE_URL>
#   Request  JSON: { "text": string, "instructions"?: string }
#   Response JSON: { "text": string }
AI_ENHANCE_URL=
# Optional bearer token sent as `Authorization: Bearer <token>` to the endpoint above.
AI_ENHANCE_KEY=
