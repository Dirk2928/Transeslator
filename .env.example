# Optional: route extracted text through your own AI cleanup endpoint.
# When unset, a local redundancy-removal + whitespace-normalization pass runs instead.
#
# Contract:
#   POST <AI_ENHANCE_URL>
#   Request  JSON: { "text": string, "instructions"?: string }
#   Response JSON: { "text": string }
AI_ENHANCE_URL=
# Optional bearer token sent as `Authorization: Bearer <key>` to the endpoint above.
AI_ENHANCE_KEY=
